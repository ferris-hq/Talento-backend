{
	# Let's Encrypt contact for certificate expiry notices.
	# email ops@example.com
}

{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Uploads go straight to R2 with presigned URLs, so API bodies stay small.
	request_body {
		max_size 5MB
	}

	reverse_proxy api:8000 {
		health_uri /healthz
		health_interval 15s
	}
}
