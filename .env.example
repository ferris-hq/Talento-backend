# Copy to .env for local development. On Hetzner these live in /opt/talento/.env (see infra/README.md).

ENVIRONMENT=development

# Supabase project (Settings -> API / Data API)
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy JWT secret. Leave empty with asymmetric signing keys.
SUPABASE_JWT_SECRET=
# Settings -> Database -> Connection string -> Session pooler (server-side only, never in the app)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# JSON list of allowed origins, only needed for browser clients
CORS_ORIGINS=[]

SENTRY_DSN=

# --- Production only (infra/docker-compose.prod.yml) ---
API_DOMAIN=api.example.com
API_IMAGE=ghcr.io/ferris-hq/talento-api:latest
